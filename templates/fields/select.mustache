{{!
    @template local_dataforge/fields/select

    This template renders the select field type.

    Example context (json):
    {
        "elementid": "1-dkjfhdjfgh",
        "options": {
            "multi": true
        },
        "extra": {
            "options": [{
                "value": "123",
                "name": "Option 1",
                "selected": false
            },
            {
                "value": "987",
                "name": "Option 2",
                "selected": true
            }]
        },
    }
}}
<select class="form-control" id="{{elementid}}" name="{{elementid}}{{#options.multi}}[]{{/options.multi}}" {{#options.multi}}multiple="multiple"{{/options.multi}}>
    {{^options.multi}}
        <option selected="selected" value="">{{#str}} pleasechoose, local_dataforge {{/str}}</option>
    {{/options.multi}}
    {{#extra.options}}
        <option value="{{value}}" {{#selected}}selected="selected"{{/selected}} >{{name}}</option>
    {{/extra.options}}
</select>
