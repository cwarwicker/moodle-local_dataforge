{{!
    @template local_dataforge/fields/editor

    This template renders the text editor field type.

    Example context (json):
    {
        "elementid": "1-hkjhfsdkjhdf",
        "_value": "2015-01-01",
    }
}}
<div>
    <textarea class="form-control" id="{{elementid}}" name="{{elementid}}"
              rows="{{#options.rows}}{{options.rows}}{{/options.rows}}{{^options.rows}}5{{/options.rows}}">
        {{_value}}
    </textarea>
</div>