{{!
    @template local_dataforge/fields/checkbox

    This template renders the checkbox field type.

    Example context (json):
    {
        "elementid": "field-1",
        "extra": {
            "class": "form-check",
            "options": [{
                "value": "123",
                "name": "Option 1",
                "selected": false
            },
            {
                "value": "987",
                "name": "Option 2",
                "selected": true
            }]
        },
    }
}}
hey
{{#extra.options}}
    <div class="{{extra.class}}">
        <input class="form-check-input" type="checkbox" name="{{elementid}}[]" value="{{value}}"
               {{#selected}}checked="checked"{{/selected}} >
        <label class="form-check-label">{{name}}</label>
    </div>
{{/extra.options}}