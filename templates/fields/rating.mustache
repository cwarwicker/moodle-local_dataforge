{{!
    @template local_dataforge/fields/rating

    This template renders the rating field type.

    Example context (json):
    {
        "elementid": "1-hkjhfsdkjhdf",
        "_value": "3",
        "options": {
            "number": 5
        }
    }
}}
<div>
    <div id="local_dataforge-rating-{{elementid}}" data-element="{{elementid}}" data-number="{{options.number}}" data-score="{{_value}}"></div>
    <input type="hidden" id="{{elementid}}" name="{{elementname}}" value="{{_value}}">
</div>

{{#js}}
require(['local_dataforge/fields/rating'], function(rating) {
    rating.init('local_dataforge-rating-{{elementid}}', '{{elementid}}');
});
{{/js}}