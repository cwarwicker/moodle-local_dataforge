{{!
    @template local_dataforge/fields/date

    This template renders the date field type.

    Example context (json):
    {
        "elementid": "1-hkjhfsdkjhdf",
        "_value": "2015-01-01",
        "options": {
            "min": "2020-01-01",
            "max": "2025-12-31",
            "time": false
        },
    }
}}
<div>
    <input type="{{#options.time}}datetime-local{{/options.time}}{{^options.time}}date{{/options.time}}"
           class="form-control" id="{{elementid}}" name="{{elementid}}"
           aria-describedby="{{elementid}}-help" value="{{_value}}"
           {{#options.min}}min="{{options.min}}" {{/options.min}}
           {{#options.max}}max="{{options.max}}" {{/options.max}}
    >
</div>