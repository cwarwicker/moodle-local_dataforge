{{!
    @template local_dataforge/fields/value/rating

    This template renders the value of a rating field.

    Example context (json):
    {
        "elementid": "dkfjhdkjgh-1",
        "value": "3",
        "options": {
            "number": 5
        }
    }
}}
<div id="{{elementid}}" data-score="{{value}}" data-number="{{options.number}}"></div>
{{#js}}
require(['local_dataforge/fields/rating'], function(rating) {
    rating.display('{{elementid}}');
});
{{/js}}