{{!
    @template local_dataforge/fields/value/matrix

    This template renders the value of a matrix field.

    Example context (json):
    {
        "options": {
            "columns": [
                {
                    "col_name": "Column 1",
                },
                {
                    "col_name": "Column 2",
                },
            ],
        },
        "matrix": {
            "rows": [
                {
                    "row_id": 1,
                    "row_name": "Row 1",
                    "cols": [
                        {
                            "col_id": 1,
                            "value": true,
                        },
                        {
                            "col_id": 2,
                            "value": false,
                        }
                    ]
                },
                "row_id": 2,
                    "row_name": "Row 2",
                    "cols": [
                        {
                            "col_id": 3,
                            "value": false,
                        },
                        {
                            "col_id": 4,
                            "value": true,
                        }
                    ]
            ]
        }
    }
}}
<div>
    <table class="table table-bordered block_cilp-table">
        <thead class="thead-dark">
        <tr>
            <th></th>
            {{#options.columns}}
                <th scope="col">{{col_name}}</th>
            {{/options.columns}}
        </tr>
        </thead>
        <tbody>
        {{#matrix.rows}}
            <tr>
                <th scope="col">{{row_name}}</th>
                {{#cols}}
                    <td>
                        {{#value}} {{#pix}} i/checked, core {{/pix}} {{/value}}
                        {{^value}}-{{/value}}
                    </td>
                {{/cols}}
            </tr>
        {{/matrix.rows}}
        </tbody>
    </table>
</div>