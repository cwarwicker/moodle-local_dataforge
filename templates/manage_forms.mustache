{{!
    @template local_dataforge/manage

    Manage forms template.

    Context variables required for this template:
    * forms - Array of form data
    * forms.name - Name of form
    * forms.typename - Full name of type of form
    * forms.contextname - Full name of context the form is in
    * contextid - Context ID of forms

    Example context (json):
    {
        "forms": [
            {
                "name": "My form",
                "typename": "Single form (Internal)",
                "contextname": "Course: Some course"
            }
        ],
        "contextid": 1
    }
}}

<div>
    <p>
        <a href="/local/dataforge/edit.php?contextid={{contextid}}" class="btn btn-primary">
            <i class="fas fa-plus"></i> {{#str}} newform, local_dataforge {{/str}}
        </a>
    </p>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>{{#str}} name, moodle {{/str}}</th>
            <th>{{#str}} type, local_dataforge {{/str}}</th>
            <th>{{#str}} context, moodle {{/str}}</th>
            <th>{{#str}} actions, local_dataforge {{/str}}</th>
        </tr>
    </thead>
    <tbody>
    {{#forms}}
        <tr>
            <td>{{name}}</td>
            <td>{{typename}}</td>
            <td>{{contextname}}</td>
            <td>
                <a href="/local/dataforge/report.php?id={{id}}" class="btn btn-info">
                    <i class="fa-solid fa-chart-pie"></i> {{#str}} reports, local_dataforge {{/str}}
                </a>
                <a href="/local/dataforge/edit.php?id={{id}}" class="btn btn-primary">
                    <i class="fas fa-edit"></i> {{#str}} edit, local_dataforge {{/str}}
                </a>
                <a href="/local/dataforge/delete.php?id={{id}}" class="btn btn-danger">
                    <i class="fas fa-trash"></i> {{#str}} delete, local_dataforge {{/str}}
                </a>
            </td>
        </tr>
    {{/forms}}
    </tbody>
</table>
